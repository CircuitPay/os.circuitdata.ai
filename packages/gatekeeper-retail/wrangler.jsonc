  },
  "r2_buckets": [
    {
      "binding": "RETAIL_RAW",
      "bucket_name": "gadgets-retail-raw"
    }
  ],
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RetailDataset",
        "RetailGatekeeper",
        "RetailConnection",
        "RetailWebhookRoute"
      ]
    }
  ]
}
