// Generated from cloudflare.config.ts by scripts/generate-worker-configs.ts -- do not edit.
// Change cloudflare.config.ts and run `pnpm configs:generate`.
{
  "name": "gatekeeper-retail",
  "main": ".wrangler/validate/src/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": [
    "allow_irrevocable_stub_storage",
    "nodejs_als"
  ],
  "limits": {
    "cpu_ms": 300000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
